# Beacon backend — copy to .env.local (gitignored) and fill in.
# None of this affects the static GitHub Pages UI; it is for the server target
# (npm run build && npm start) and the agent worker (npm run agent) on WSL.

# --- Database (optional) ---
# OPTIONAL. If set and reachable, Beacon uses Postgres (the docker one-liner in
# BACKEND-PLAN.md §7 matches this URL). If unset or unreachable, the server runs
# in no-database mode: base snapshot from the faked Jira, event + run logs under
# .data/ (see `npm run local:nodb`). Comment this out to force no-DB mode.
DATABASE_URL=postgres://postgres:beacon@localhost:5432/beacon

# --- Agent run config (Phase 2) ---
BEACON_URL=http://localhost:3000
BEACON_AGENT_INTERVAL_MINS=60
BEACON_TRIGGER_ON_EVENT=true
# BEACON_QUIET_HOURS=20:00-07:00
# BEACON_PORT=3000        # npm run local picks a free port from here up

# --- LLM detector (Phase 3) ---
# Provider: openai | ollama | none. Omit to auto-detect (openai if a key is set,
# else none/rules). Detector: rules | llm | both (both runs the model and logs a
# comparison against the regex detector for A/B).
# BEACON_LLM_PROVIDER=openai
# BEACON_DETECTOR=both
# Let the model draft the approve-preview comments (§4 job 4 / §9.1). Off by
# default — rule templates are used, and the /api/agent/compose route still
# drafts on demand when a provider is configured.
# BEACON_COMPOSE=true

# OpenAI (the key you provide)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Locally hosted Ollama on WSL — set BEACON_LLM_PROVIDER=ollama to use it.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_EMBED_MODEL=nomic-embed-text
