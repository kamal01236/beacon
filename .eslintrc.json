{
  "root": true,
  "extends": [
    "next/core-web-vitals"
  ],
  "ignorePatterns": [
    "out/",
    ".next/",
    "node_modules/",
    "docs/diagrams/vendor/",
    "coverage/"
  ],
  "rules": {
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error",
          "log"
        ]
      }
    ],
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-var": "error",
    "prefer-const": "error",
    "@next/next/no-page-custom-font": "off"
  },
  "overrides": [
    {
      "files": [
        "scripts/**/*.mjs",
        "agent/**/*.mjs",
        "test/**/*.ts"
      ],
      "env": {
        "node": true
      },
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
